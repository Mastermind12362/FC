	LoadingText.BackgroundTransparency = 1
	LoadingText.TextTransparency = 1
	LoadingText.ZIndex = 101
	LoadingText.Parent = IntroFrame

	Utility:Tween(Logo, {Position = UDim2.new(0.5, -75, 0.5, -75)}, 1, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	Utility:Tween(LoadingText, {TextTransparency = 0}, 1)
	task.wait(1.2)
	Utility:Tween(Logo, {Rotation = 360}, 1, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	task.wait(1.5)
	Utility:Tween(Logo, {Rotation = 720}, 1, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	task.wait(1.5)
	Utility:Tween(Logo, {ImageTransparency = 1, Size = UDim2.new(0, 200, 0, 200)}, 0.8)
	Utility:Tween(LoadingText, {TextTransparency = 1}, 0.8)
	task.wait(0.5)
	
	MainFrame.Visible = true
	MainFrame.Size = UDim2.new(0, 0, 0, 0)
	MainFrame.BackgroundTransparency = 1
	Utility:Tween(MainFrame, {Size = UDim2.new(0, 650, 0, 420), BackgroundTransparency = 0.1}, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
