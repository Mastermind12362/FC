function Library:PlaySound()
	if not Library.NotificationSoundEnabled then return end
	pcall(function()
		local sound = Instance.new("Sound")
		if string.find(Library.NotificationSoundID, "rbxassetid://") then
			sound.SoundId = Library.NotificationSoundID
		else
			sound.SoundId = "rbxassetid://" .. Library.NotificationSoundID
		end
		sound.Volume = 1
		sound.Parent = SoundService
		sound:Play()
		sound.Ended:Connect(function() sound:Destroy() end)
	end)
end

function Library:PlayIntro(MainFrame: Frame)
	local ScreenGui = Library.ScreenGui
