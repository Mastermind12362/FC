	Logo.Position = UDim2.new(0.5, -75, 1.2, 0)
	Logo.BackgroundTransparency = 1
	Logo.Image = Library.LogoID
	Logo.ZIndex = 101
	Logo.Parent = IntroFrame
	
	local LoadingText = Instance.new("TextLabel")
