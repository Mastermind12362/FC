		local scrollPos = TabContainer.CanvasPosition.Y
		local maxScroll = canvasHeight - windowHeight
		
		if maxScroll > 5 and scrollPos < (maxScroll - 5) then
			ScrollArrow.Visible = true
		else
			ScrollArrow.Visible = false
		end
	end
	
