			function SectionObj:Keybind(text: string, default: Enum.KeyCode, callback: (Enum.KeyCode) -> (), flag: string?)
				local CurrentKey = default
				--// CHECK SAVED CONFIG //--
				if flag and Library.Flags[flag] then
					local savedKey = Enum.KeyCode[Library.Flags[flag]]
					if savedKey then CurrentKey = savedKey end
				end
				
				local Binding = false
