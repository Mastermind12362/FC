			function SectionObj:Toggle(text: string, default: boolean, callback: (boolean) -> (), flag: string?)
				local Toggled = default or false
				--// CHECK SAVED CONFIG //--
				if flag and Library.Flags[flag] ~= nil then
					Toggled = Library.Flags[flag]
				end
				
				local TogBtn = Instance.new("TextButton", Container)
				TogBtn.Size = UDim2.new(1, 0, 0, 32)
				TogBtn.BackgroundColor3 = THEME.Element
				TogBtn.Text = ""
				TogBtn.AutoButtonColor = false
				local TogC = Instance.new("UICorner", TogBtn)
				TogC.CornerRadius = UDim.new(0, 4)
				local TogS = Instance.new("UIStroke", TogBtn)
				TogS.Color = THEME.Outline
				TogS.Thickness = 1
				local Label = Instance.new("TextLabel", TogBtn)
				Label.Text = text
				Label.Size = UDim2.new(1, -40, 1, 0)
				Label.Position = UDim2.new(0, 10, 0, 0)
				Label.BackgroundTransparency = 1
				Label.TextColor3 = THEME.Text
				Label.Font = Enum.Font.Gotham
				Label.TextSize = 14
				Label.TextXAlignment = Enum.TextXAlignment.Left
				local Box = Instance.new("Frame", TogBtn)
				Box.Size = UDim2.new(0, 20, 0, 20)
				Box.Position = UDim2.new(1, -30, 0.5, -10)
				Box.BackgroundColor3 = Toggled and THEME.Accent or Color3.fromRGB(25,25,25)
				local BoxC = Instance.new("UICorner", Box)
				BoxC.CornerRadius = UDim.new(0, 4)
				local BoxS = Instance.new("UIStroke", Box)
				BoxS.Color = THEME.Outline
				BoxS.Thickness = 1
				
				local function UpdateState(val)
					Toggled = val
					Utility:Tween(Box, {BackgroundColor3 = Toggled and THEME.Accent or Color3.fromRGB(25,25,25)})
					if flag then Library.Flags[flag] = Toggled end
					callback(Toggled)
				end
				
				TogBtn.MouseEnter:Connect(function() Utility:Tween(TogBtn, {BackgroundColor3 = THEME.Hover}) end)
				TogBtn.MouseLeave:Connect(function() Utility:Tween(TogBtn, {BackgroundColor3 = THEME.Element}) end)
				TogBtn.MouseButton1Click:Connect(function() UpdateState(not Toggled) end)
				
				if flag then
					Library.Options[flag] = {
						Default = default,
						Set = function(val) UpdateState(val) end
					}
					Library.Flags[flag] = Toggled
				end
				
				-- Trigger initial callback if loaded from config
				if flag and Library.Flags[flag] ~= nil and Library.Flags[flag] ~= default then
					callback(Toggled)
				end
			end
			
			function SectionObj:Slider(text: string, min: number, max: number, default: number, callback: (number) -> (), flag: string?)
				local Value = default or min
				--// CHECK SAVED CONFIG //--
				if flag and Library.Flags[flag] ~= nil then
					Value = Library.Flags[flag]
				end
				
				local Dragging = false
				local SliderFrame = Instance.new("Frame", Container)
				SliderFrame.Size = UDim2.new(1, 0, 0, 45)
				SliderFrame.BackgroundColor3 = THEME.Element
				local SlC = Instance.new("UICorner", SliderFrame)
				SlC.CornerRadius = UDim.new(0, 4)
				local SlS = Instance.new("UIStroke", SliderFrame)
				SlS.Color = THEME.Outline
				SlS.Thickness = 1
				local Label = Instance.new("TextLabel", SliderFrame)
				Label.Text = text
				Label.Size = UDim2.new(1, -10, 0, 20)
				Label.Position = UDim2.new(0, 10, 0, 2)
				Label.BackgroundTransparency = 1
				Label.TextColor3 = THEME.Text
				Label.Font = Enum.Font.Gotham
				Label.TextSize = 14
				Label.TextXAlignment = Enum.TextXAlignment.Left
				local ValLabel = Instance.new("TextLabel", SliderFrame)
				ValLabel.Text = tostring(Value)
				ValLabel.Size = UDim2.new(0, 40, 0, 20)
				ValLabel.Position = UDim2.new(1, -50, 0, 2)
				ValLabel.BackgroundTransparency = 1
				ValLabel.TextColor3 = THEME.TextDark
				ValLabel.Font = Enum.Font.Gotham
				ValLabel.TextSize = 14
				
				local Bar = Instance.new("TextButton", SliderFrame)
				Bar.Text = ""
				Bar.AutoButtonColor = false
				Bar.Size = UDim2.new(1, -20, 0, 6)
				Bar.Position = UDim2.new(0, 10, 0, 30)
				Bar.BackgroundColor3 = Color3.fromRGB(25,25,25)
				local BarC = Instance.new("UICorner", Bar)
				BarC.CornerRadius = UDim.new(1, 0)
				local Fill = Instance.new("Frame", Bar)
				Fill.Size = UDim2.new((Value - min) / (max - min), 0, 1, 0)
				Fill.BackgroundColor3 = THEME.Accent
				local FillC = Instance.new("UICorner", Fill)
				FillC.CornerRadius = UDim.new(1, 0)
				
				local function SetValue(val)
					val = math.clamp(val, min, max)
					Value = val
					ValLabel.Text = tostring(val)
					local percent = (val - min) / (max - min)
					Utility:Tween(Fill, {Size = UDim2.new(percent, 0, 1, 0)}, 0.05)
					if flag then Library.Flags[flag] = val end
					callback(val)
				end
				
				local function Update(input)
					local percent = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
					local newVal = math.floor(min + (max - min) * percent)
					SetValue(newVal)
				end
				
				Bar.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						Dragging = true
						Update(input)
					end
				end)
				UserInputService.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then Dragging = false end
				end)
				UserInputService.InputChanged:Connect(function(input)
					if Dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then Update(input) end
				end)
				
				if flag then
					Library.Options[flag] = {
						Default = default,
						Set = function(val) SetValue(val) end
					}
					Library.Flags[flag] = Value
				end
			end
			
