--// CONFIG SYSTEM FUNCTIONS //--
function Library:SaveConfig(name: string)
	if not name or name == "" then Library:Notify("Config", "Please enter a config name!", 2) return end
	local json = HttpService:JSONEncode(Library.Flags)
	SaveFile(name .. ".titan", json)
	Library:Notify("Config", "Saved configuration: " .. name, 3)
end

function Library:LoadConfig(name: string)
	if not name or name == "" then Library:Notify("Config", "Please enter a config name!", 2) return end
	local data = LoadFile(name .. ".titan")
	if data then
		local success, decoded = pcall(function() return HttpService:JSONDecode(data) end)
		if success and decoded then
			for flag, value in pairs(decoded) do
				if Library.Options[flag] then
					Library.Options[flag].Set(value)
				end
			end
			Library:Notify("Config", "Loaded configuration: " .. name, 3)
		else
			Library:Notify("Config", "Failed to decode JSON.", 3)
		end
	else
		Library:Notify("Config", "File not found.", 3)
	end
end

function Library:ResetConfig()
	for flag, option in pairs(Library.Options) do
		if option.Set and option.Default ~= nil then
			option.Set(option.Default)
		end
	end
	Library:Notify("Config", "Configuration reset to defaults.", 2)
end

