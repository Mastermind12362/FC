				Label.Font = Enum.Font.Gotham
				Label.TextSize = 14
				Label.TextXAlignment = Enum.TextXAlignment.Left
				
				local BindLabel = Instance.new("TextLabel", KeyBtn)
				BindLabel.Text = CurrentKey.Name
				BindLabel.Size = UDim2.new(0, 60, 0, 20)
				BindLabel.Position = UDim2.new(1, -70, 0.5, -10)
				BindLabel.BackgroundColor3 = Color3.fromRGB(25,25,25)
				BindLabel.TextColor3 = THEME.TextDark
				BindLabel.Font = Enum.Font.GothamBold
				BindLabel.TextSize = 12
				local BindC = Instance.new("UICorner", BindLabel)
				BindC.CornerRadius = UDim.new(0, 4)
				
				local function SetKey(key)
					CurrentKey = key
					BindLabel.Text = key.Name
					if flag then Library.Flags[flag] = key.Name end -- Save as string
					callback(key)
				end
				
				KeyBtn.MouseButton1Click:Connect(function()
					Binding = true
					BindLabel.Text = "..."
					BindLabel.TextColor3 = THEME.Accent
					local inputConn
					inputConn = UserInputService.InputBegan:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.Keyboard then
							Binding = false
							BindLabel.TextColor3 = THEME.TextDark
							SetKey(input.KeyCode)
							inputConn:Disconnect()
						end
					end)
				end)
				
				if flag then
					Library.Options[flag] = {
						Default = default,
						Set = function(val) 
							if typeof(val) == "string" then val = Enum.KeyCode[val] end
							SetKey(val) 
						end
					}
					Library.Flags[flag] = CurrentKey.Name
				end
			end
			
