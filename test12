	--// CREATE CONFIG TAB HELPER //--
	function Window:CreateConfigTab(tabName: string)
		local Tab = Window:Tab(tabName or "Settings")
		local Section = Tab:Section("Configuration")
		
		local ConfigName = ""
		Section:TextBox("Config Name", "Ex: LegitSettings", function(v)
			ConfigName = v
		end)
		
		Section:Button("Save Config", function()
			Library:SaveConfig(ConfigName)
		end)
		
		Section:Button("Load Config", function()
			Library:LoadConfig(ConfigName)
		end)
		
		Section:Button("Reset Config", function()
			ConfirmModal.Visible = true
		end)
	end
	
	task.spawn(function()
		Library:PlayIntro(MainFrame)
	end)
	
	return Window
end

return Library
