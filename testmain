				local InC = Instance.new("UICorner", Input)
				InC.CornerRadius = UDim.new(0, 4)
				
				Input.Focused:Connect(function()
					Utility:Tween(BoxS, {Color = THEME.Accent})
				end)
				Input.FocusLost:Connect(function(enter)
					Utility:Tween(BoxS, {Color = THEME.Outline})
					if enter then callback(Input.Text) end
				end)
			end
			function SectionObj:Keybind(text: string, default: Enum.KeyCode, callback: (Enum.KeyCode) -> ())
				local CurrentKey = default
				local Binding = false
				local KeyBtn = Instance.new("TextButton", Container)
				KeyBtn.Size = UDim2.new(1, 0, 0, 32)
				KeyBtn.BackgroundColor3 = THEME.Element
				KeyBtn.Text = ""
				KeyBtn.AutoButtonColor = false
				local KeyC = Instance.new("UICorner", KeyBtn)
				KeyC.CornerRadius = UDim.new(0, 6)
				local KeyS = Instance.new("UIStroke", KeyBtn)
				KeyS.Color = THEME.Outline
				KeyS.Thickness = 1
				local Label = Instance.new("TextLabel", KeyBtn)
				Label.Text = text
				Label.Size = UDim2.new(1, -80, 1, 0)
				Label.Position = UDim2.new(0, 10, 0, 0)
				Label.BackgroundTransparency = 1
				Label.TextColor3 = THEME.Text
				Label.Font = Enum.Font.Gotham
				Label.TextSize = 14
				Label.TextXAlignment = Enum.TextXAlignment.Left
				local BindLabel = Instance.new("TextLabel", KeyBtn)
				BindLabel.Text = CurrentKey.Name
				BindLabel.Size = UDim2.new(0, 60, 0, 20)
				BindLabel.Position = UDim2.new(1, -70, 0.5, -10)
				BindLabel.BackgroundColor3 = Color3.fromRGB(20,20,20)
				BindLabel.TextColor3 = THEME.TextDark
				BindLabel.Font = Enum.Font.GothamBold
				BindLabel.TextSize = 12
				local BindC = Instance.new("UICorner", BindLabel)
				BindC.CornerRadius = UDim.new(0, 4)
				KeyBtn.MouseButton1Click:Connect(function()
					Binding = true
					BindLabel.Text = "..."
					BindLabel.TextColor3 = THEME.Accent
					local inputConn
					inputConn = UserInputService.InputBegan:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.Keyboard then
							Binding = false
							CurrentKey = input.KeyCode
							BindLabel.Text = input.KeyCode.Name
							BindLabel.TextColor3 = THEME.TextDark
							callback(input.KeyCode)
							inputConn:Disconnect()
						end
					end)
				end)
			end
