function Utility:Tween(obj: Instance, props: table, time: number?, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	-- Changed default to Exponential for a snappier, modern feel
	local info = TweenInfo.new(time or 0.25, style or Enum.EasingStyle.Exponential, dir or Enum.EasingDirection.Out)
	local tween = TweenService:Create(obj, info, props)
	tween:Play()
	return tween
end

function Utility:Ripple(obj: GuiObject)
	task.spawn(function()
		local Ripple = Instance.new("ImageLabel")
		Ripple.Name = "Ripple"
		Ripple.BackgroundTransparency = 1
		Ripple.BorderSizePixel = 0
		Ripple.Image = "rbxassetid://2708891598"
		Ripple.ImageColor3 = Color3.fromRGB(255, 255, 255)
		Ripple.ImageTransparency = 0.6
		Ripple.ZIndex = 9
		Ripple.Parent = obj
		
		-- Calculate position relative to object
		local MousePos = UserInputService:GetMouseLocation()
		local RelativeX = MousePos.X - obj.AbsolutePosition.X
		local RelativeY = MousePos.Y - obj.AbsolutePosition.Y - 36 -- Offset for TopBar inset if needed
		
		Ripple.Position = UDim2.new(0, RelativeX, 0, RelativeY)
		Ripple.Size = UDim2.new(0, 0, 0, 0)
		
		local Size = math.max(obj.AbsoluteSize.X, obj.AbsoluteSize.Y) * 1.5
		
		Utility:Tween(Ripple, {Size = UDim2.new(0, Size, 0, Size), Position = UDim2.new(0, RelativeX - Size/2, 0, RelativeY - Size/2)}, 0.5)
		local Fade = Utility:Tween(Ripple, {ImageTransparency = 1}, 0.5)
		
		Fade.Completed:Wait()
		Ripple:Destroy()
	end)
end

function Library:PlaySound()
	if not Library.NotificationSoundEnabled then return end
	task.spawn(function()
		local sound = Instance.new("Sound")
		sound.SoundId = string.find(Library.NotificationSoundID, "rbxassetid://") and Library.NotificationSoundID or "rbxassetid://" .. Library.NotificationSoundID
		sound.Volume = 0.5
		sound.Parent = SoundService
		sound:Play()
		sound.Ended:Connect(function() sound:Destroy() end)
	end)
end

function Library:PlayIntro(MainFrame: Frame)
	local ScreenGui = Library.ScreenGui
	local IntroFrame = Instance.new("Frame")
	IntroFrame.Name = "Intro"
	IntroFrame.Size = UDim2.new(1, 0, 1, 0)
	IntroFrame.BackgroundTransparency = 1
	IntroFrame.ZIndex = 100
	IntroFrame.Parent = ScreenGui
	
	local Logo = Instance.new("ImageLabel")
	Logo.Size = UDim2.new(0, 0, 0, 0) -- Start small
	Logo.Position = UDim2.new(0.5, 0, 0.5, 0)
	Logo.BackgroundTransparency = 1
	Logo.Image = Library.LogoID
	Logo.ZIndex = 101
	Logo.Parent = IntroFrame
	
	-- Pop in
	Utility:Tween(Logo, {Size = UDim2.new(0, 120, 0, 120), Position = UDim2.new(0.5, -60, 0.5, -60)}, 0.6, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
	task.wait(0.8)
	
	-- Spin and fade out
	Utility:Tween(Logo, {Rotation = 360, ImageTransparency = 1, Size = UDim2.new(0, 150, 0, 150), Position = UDim2.new(0.5, -75, 0.5, -75)}, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	task.wait(0.4)
	
	MainFrame.Visible = true
	MainFrame.Size = UDim2.new(0, 0, 0, 420) -- Start as a vertical line
	MainFrame.BackgroundTransparency = 1
	
	-- Expand width
	Utility:Tween(MainFrame, {Size = UDim2.new(0, 650, 0, 420), BackgroundTransparency = 0}, 0.6, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out)
	task.wait(0.6)
	IntroFrame:Destroy()
end

