		-- Slide In
		Utility:Tween(Inner, {Position = UDim2.new(0, 0, 0, 0)}, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		task.wait(0.2)
		Utility:Tween(Bar, {Size = UDim2.new(0, 3, 0.8, 0)}, 0.3)
		
		task.wait(duration or 3)
		
		-- Slide Out
		local OutTween = Utility:Tween(Inner, {Position = UDim2.new(1, 60, 0, 0)}, 0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		OutTween.Completed:Wait()
